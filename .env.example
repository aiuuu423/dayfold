# Browser-visible configuration; never place secrets in VITE_* variables.
VITE_DAYFOLD_API_ORIGIN=https://dayfold-api-global.vercel.app
VITE_CLOUDBASE_ENV_ID=
VITE_CLOUDBASE_REGION=ap-shanghai
VITE_CLOUDBASE_PUBLISHABLE_KEY=

# Server-only configuration.
DAYFOLD_DEMO_MODE=false
DAYFOLD_ALLOWED_ORIGINS=https://www.dayfold.com.cn
DAYFOLD_CLOUDBASE_ENV_ID=
DAYFOLD_USER_STATUS_BACKEND=cloudbase_http
DAYFOLD_DATA_BACKEND=turso
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Local development alternative:
# DAYFOLD_DATA_BACKEND=sqlite
# DAYFOLD_DATABASE_PATH=local/dayfold-demo.sqlite3
ARK_AGENT_BASE_URL=
ARK_AGENT_MODEL=doubao-seed-2-1-turbo
DAYFOLD_MEMORY_MODEL=doubao-seed-2-0-mini
ARK_AGENT_API_KEY=
DAYFOLD_STANDARD_ARK_API_KEY=
DAYFOLD_STANDARD_ARK_MODEL=
DAYFOLD_STANDARD_ARK_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/chat/completions
ARK_EMBEDDING_MODEL=doubao-embedding-vision-251215
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MEMORY_MODEL=deepseek-ai/DeepSeek-V3.1-Terminus
SILICONFLOW_API_KEY=
DIFY_BASE_URL=https://api.dify.ai/v1
DIFY_WORKFLOW_MODEL=deepseek-ai/DeepSeek-V3.1-Terminus
DIFY_WORKFLOW_API_KEY=
DIFY_WORKFLOW_VERSION="2026-09-17 14:27"
DATABASE_URL=
AUTH_SECRET=
